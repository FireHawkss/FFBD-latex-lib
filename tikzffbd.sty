      ffbd/and/.append~style={fill=\l__ffbd_and_fill_tl},
      ffbd/or/.append~style={fill=\l__ffbd_or_fill_tl},
      ffbd/annotation/.append~style={fill=\l__ffbd_annotation_fill_tl}}
  }{
    \tikzset{
      ffbd/function/.append~style={fill=none},
      ffbd/terminal/.append~style={fill=none},
      ffbd/and/.append~style={fill=none},
      ffbd/or/.append~style={fill=none},
