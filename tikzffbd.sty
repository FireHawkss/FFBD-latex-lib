      minimum~width=9mm,minimum~height=6mm,inner~sep=1mm,
      font=\sffamily\bfseries\scriptsize},
    ffbd/or/.style={
      draw=\l__ffbd_or_draw_tl,text=\l__ffbd_ink_tl,
