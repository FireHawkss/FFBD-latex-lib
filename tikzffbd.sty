%% tikzffbd.sty -- Functional Flow Block Diagrams without low-level TikZ
\NeedsTeXFormat{LaTeX2e}
\ProvidesExplPackage{tikzffbd}{2026-09-22}{0.4.1}
  {Automatic, polished Functional Flow Block Diagrams}

\ExplSyntaxOff
\RequirePackage{iftex}
\ifLuaTeX\else
  \PackageError{tikzffbd}{LuaLaTeX is required}{Compile this document with LuaLaTeX.}
  \expandafter\endinput
\fi
\RequirePackage{tikz}
\RequirePackage{graphicx}
\usetikzlibrary{arrows.meta,backgrounds,calc,positioning}
\ExplSyntaxOn
\directlua{tikzffbd_path=assert(kpse.find_file("tikzffbd-bridge.lua"));tikzffbd_dir=tikzffbd_path:match("^(.*[/\\])")or"./";package.path=tikzffbd_dir.."?.lua;"..package.path;tikzffbd_bridge=dofile(tikzffbd_path)}

% Messages
\msg_new:nnn {tikzffbd}{duplicate}{Function~identifier~'#1'~is~already~declared.}
\msg_new:nnn {tikzffbd}{unknown}{Function~identifier~'#1'~is~not~declared.}
\msg_new:nnn {tikzffbd}{bad-id}
  {Identifier~'#1'~is~invalid.~Use~letters,~digits,~colons,~or~hyphens.}
\msg_new:nnn {tikzffbd}{theme}{Theme~'#1'~is~unknown;~using~ocean.}
\msg_new:nnn {tikzffbd}{tall}
  {Diagram~height~#1~exceeds~80~percent~of~the~text~height.}
\msg_new:nnn {tikzffbd}{duplicate-structure}
  {Structure~identifier~'#1'~is~already~declared.}
\msg_new:nnn {tikzffbd}{empty-structure}
  {Structure~'#1'~must~contain~at~least~one~function.}
\msg_new:nnn {tikzffbd}{overlapping-structures}
  {Structures~'#1'~and~'#2'~overlap.~Use~disjoint~groups~or~increase~spacing.}
\msg_new:nnn {tikzffbd}{member-structure}
  {Function~'#1'~already~belongs~to~structure~'#2'.}
\msg_new:nnn {tikzffbd}{not-member}
  {Port~function~'#1'~is~not~a~member~of~structure~'#2'.}
\msg_new:nnn {tikzffbd}{bad-structure-port}
  {Flow~'#1'~to~'#2'~crosses~structure~'#3'~through~an~undeclared~port.}
\msg_new:nnn {tikzffbd}{row-break}
  {\string\endrow~must~follow~a~forward~flow,~branch,~or~join.}
\msg_new:nnn {tikzffbd}{columns}{max-columns~must~be~at~least~1.}

