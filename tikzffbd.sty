% Nodes
\tl_new:N \l__ffbd_requested_number_tl
\keys_define:nn {tikzffbd/function}{
  number .tl_set:N=\l__ffbd_requested_number_tl}
\cs_new_protected:Npn \__ffbd_node:nnnn #1#2#3#4{
  \prop_if_in:NnTF \l__ffbd_label_prop {#1}
    {\msg_error:nnn {tikzffbd}{duplicate}{#1}}
    {
      \regex_match:nnF {\A[-A-Za-z0-9:]+\Z}{#1}
        {\msg_error:nnn {tikzffbd}{bad-id}{#1}}
      \tl_clear:N \l__ffbd_requested_number_tl
      \keys_set:nn {tikzffbd/function}{#4}
      \tl_if_blank:VTF \l__ffbd_requested_number_tl
        {
          \int_incr:N \l__ffbd_number_int
          \tl_set:Nx \l__ffbd_requested_number_tl
            {\int_use:N \l__ffbd_number_int}
        }
        {
          \str_if_eq:VnT \l__ffbd_requested_number_tl {none}
            {\tl_clear:N \l__ffbd_requested_number_tl}
        }
      \seq_put_right:Nn \l__ffbd_nodes_seq {#1}
      \prop_put:Nnn \l__ffbd_label_prop {#1}{#2}
      \prop_put:NnV \l__ffbd_number_prop {#1}\l__ffbd_requested_number_tl
      \prop_put:Nnn \l__ffbd_type_prop {#1}{#3}
      \prop_put:Nnn \l__ffbd_rank_prop {#1}{0}
    }
}
\cs_new_protected:Npn \__ffbd_require:n #1{
  \prop_if_in:NnF \l__ffbd_label_prop {#1}
    {\msg_error:nnn {tikzffbd}{unknown}{#1}}
}
\cs_new_protected:Npn \__ffbd_edge:nn #1#2{
  \__ffbd_require:n {#1}\__ffbd_require:n {#2}
  \seq_put_right:Nn \l__ffbd_edges_seq {{#1}{#2}}
}
\NewDocumentCommand \ffbdFunction {O{}mm}
  {\__ffbd_node:nnnn {#2}{#3}{function}{#1}}
\NewDocumentCommand \ffbdStart {O{}mm}
  {\__ffbd_node:nnnn {#2}{#3}{terminal}{number=none,#1}}
\NewDocumentCommand \ffbdFinish {O{}mm}
  {\__ffbd_node:nnnn {#2}{#3}{terminal}{number=none,#1}}

% Containers for loops, decomposed functions, and custom subsystems.
\tl_new:N \l__ffbd_structure_type_tl
\tl_new:N \l__ffbd_structure_info_tl
\tl_new:N \l__ffbd_structure_style_tl
\tl_new:N \l__ffbd_structure_id_tl
\clist_new:N \l__ffbd_structure_members_clist
\clist_new:N \l__ffbd_structure_inputs_clist
\clist_new:N \l__ffbd_structure_outputs_clist
\keys_define:nn {tikzffbd/structure}{
  type .tl_set:N=\l__ffbd_structure_type_tl,
  info .tl_set:N=\l__ffbd_structure_info_tl,
  condition .tl_set:N=\l__ffbd_structure_info_tl,
  inputs .clist_set:N=\l__ffbd_structure_inputs_clist,
  input .clist_set:N=\l__ffbd_structure_inputs_clist,
  outputs .clist_set:N=\l__ffbd_structure_outputs_clist,
  output .clist_set:N=\l__ffbd_structure_outputs_clist,
  style .choice:,
  style/shaded .code:n={\tl_set:Nn\l__ffbd_structure_style_tl{shaded}},
  style/dashed .code:n={\tl_set:Nn\l__ffbd_structure_style_tl{dashed}},
  style/plain .code:n={\tl_set:Nn\l__ffbd_structure_style_tl{plain}}
}
\cs_new_protected:Npn \__ffbd_structure_port:nn #1#2{
  \tl_set:Nx\l_tmpa_tl{\tl_trim_spaces:n{#1}}
  \clist_if_in:NVF\l__ffbd_structure_members_clist\l_tmpa_tl
    {\msg_error:nnVV{tikzffbd}{not-member}\l_tmpa_tl\l__ffbd_structure_id_tl}
}
\cs_new_protected:Npn \__ffbd_structure_member:n #1{
  \tl_set:Nx\l_tmpa_tl{\tl_trim_spaces:n{#1}}
  \exp_args:NV\__ffbd_require:n\l_tmpa_tl
  \prop_get:NVNTF\l__ffbd_member_structure_prop\l_tmpa_tl\l_tmpb_tl
    {\msg_error:nnVV{tikzffbd}{member-structure}\l_tmpa_tl\l_tmpb_tl}
    {\prop_put:NVV\l__ffbd_member_structure_prop\l_tmpa_tl\l__ffbd_structure_id_tl}
}
\NewDocumentCommand \__ffbd_legacy_structure {O{}mm}{
  \tl_set:Nx\l__ffbd_structure_id_tl{\tl_trim_spaces:n{#2}}
  \regex_match:nnF {\A[-A-Za-z0-9:]+\Z}{#2}
    {\msg_error:nnn {tikzffbd}{bad-id}{#2}}
  \prop_if_in:NVTF\l__ffbd_structure_type_prop\l__ffbd_structure_id_tl
    {\msg_error:nnV{tikzffbd}{duplicate-structure}\l__ffbd_structure_id_tl}
    {
      \tl_set:Nn\l__ffbd_structure_type_tl{Function}
      \tl_clear:N\l__ffbd_structure_info_tl
      \tl_set:Nn\l__ffbd_structure_style_tl{shaded}
      \clist_set:Nn\l__ffbd_structure_members_clist{#3}
      \clist_clear:N\l__ffbd_structure_inputs_clist
      \clist_clear:N\l__ffbd_structure_outputs_clist
      \keys_set:nn{tikzffbd/structure}{#1}
      \clist_if_empty:NT\l__ffbd_structure_members_clist
        {\msg_error:nnV{tikzffbd}{empty-structure}\l__ffbd_structure_id_tl}
      \clist_map_inline:Nn\l__ffbd_structure_members_clist
        {\__ffbd_structure_member:n{##1}}
      \clist_map_inline:Nn\l__ffbd_structure_inputs_clist
        {\__ffbd_structure_port:nn{##1}{input}}
      \clist_map_inline:Nn\l__ffbd_structure_outputs_clist
        {\__ffbd_structure_port:nn{##1}{output}}
      \seq_put_right:NV\l__ffbd_structures_seq\l__ffbd_structure_id_tl
      \prop_put:NVV\l__ffbd_structure_type_prop
        \l__ffbd_structure_id_tl\l__ffbd_structure_type_tl
      \prop_put:NVV\l__ffbd_structure_info_prop
        \l__ffbd_structure_id_tl\l__ffbd_structure_info_tl
      \prop_put:NVV\l__ffbd_structure_style_prop
        \l__ffbd_structure_id_tl\l__ffbd_structure_style_tl
      \prop_put:NVx\l__ffbd_structure_members_prop\l__ffbd_structure_id_tl
        {\clist_use:Nn\l__ffbd_structure_members_clist{,}}
      \prop_put:NVx\l__ffbd_structure_inputs_prop\l__ffbd_structure_id_tl
        {\clist_use:Nn\l__ffbd_structure_inputs_clist{,}}
      \prop_put:NVx\l__ffbd_structure_outputs_prop\l__ffbd_structure_id_tl
        {\clist_use:Nn\l__ffbd_structure_outputs_clist{,}}
    }
}

% Relationships
\tl_new:N \l__ffbd_edge_label_tl
\keys_define:nn {tikzffbd/flow}{
  label .tl_set:N=\l__ffbd_edge_label_tl,
  condition .tl_set:N=\l__ffbd_edge_label_tl}
\NewDocumentCommand \__ffbd_legacy_flow {O{}mm}{
  \tl_clear:N \l__ffbd_edge_label_tl
  \keys_set:nn {tikzffbd/flow}{#1}
  \__ffbd_edge:nn {#2}{#3}
  \seq_put_right:Nx \l__ffbd_flows_seq
    {{#2}{#3}{\exp_not:V \l__ffbd_edge_label_tl}}
  \tl_set:Nn \l__ffbd_last_forward_tl {#3}
}
% Logical connectors participate in ranking and measurement just like blocks.
\tl_new:N \l__ffbd_source_tl
\cs_new_protected:Npn \__ffbd_connector:n #1{
  \int_incr:N \l__ffbd_connector_int
  \tl_set:Nx \l__ffbd_source_tl {@c\int_use:N\l__ffbd_connector_int}
  \seq_put_right:NV \l__ffbd_nodes_seq \l__ffbd_source_tl
  \prop_put:NVx \l__ffbd_label_prop \l__ffbd_source_tl {\str_uppercase:n{#1}}
  \prop_put:NVn \l__ffbd_number_prop \l__ffbd_source_tl {}
  \prop_put:NVn \l__ffbd_type_prop \l__ffbd_source_tl {#1}
  \prop_put:NVn \l__ffbd_rank_prop \l__ffbd_source_tl {0}
}
\cs_new_protected:Npn \__ffbd_branch_plain:n #1
  {\__ffbd_branch_labeled:nn {#1}{}}
\cs_new_protected:Npn \__ffbd_branch_labeled:nn #1#2{
  \tl_set:Nx \l_tmpa_tl {\tl_trim_spaces:n{#1}}
  \exp_args:NVV \__ffbd_edge:nn \l__ffbd_source_tl \l_tmpa_tl
  \seq_put_right:Nx \l__ffbd_flows_seq
    {{\l__ffbd_source_tl}{\l_tmpa_tl}{\exp_not:n{#2}}}
  \tl_set:Nx \l__ffbd_last_forward_tl {\l_tmpa_tl}
}
\NewDocumentCommand \__ffbd_legacy_branch {O{and}mm}{
  \__ffbd_connector:n {#1}
  \exp_args:NnV \__ffbd_edge:nn {#2}\l__ffbd_source_tl
  \seq_put_right:Nx \l__ffbd_flows_seq {{#2}{\l__ffbd_source_tl}{}}
  \keyval_parse:NNn \__ffbd_branch_plain:n \__ffbd_branch_labeled:nn {#3}
}
\NewDocumentCommand \__ffbd_legacy_join {O{and}mm}{
  \__ffbd_connector:n {#1}
  \clist_map_inline:nn {#2}{
    \exp_args:NnV \__ffbd_edge:nn {##1}\l__ffbd_source_tl
    \seq_put_right:Nx \l__ffbd_flows_seq {{##1}{\l__ffbd_source_tl}{}}
  }
  \exp_args:NV \__ffbd_edge:nn \l__ffbd_source_tl {#3}
  \seq_put_right:Nx \l__ffbd_flows_seq {{\l__ffbd_source_tl}{#3}{}}
  \tl_set:Nn \l__ffbd_last_forward_tl {#3}
}
\NewDocumentCommand \__ffbd_legacy_endrow {}{
  \tl_if_blank:VTF \l__ffbd_last_forward_tl
    {\msg_error:nn {tikzffbd}{row-break}}
    {\seq_put_right:NV \l__ffbd_row_break_nodes_seq \l__ffbd_last_forward_tl}
}
\tl_new:N \l__ffbd_loop_label_tl
\tl_new:N \l__ffbd_loop_side_tl
\keys_define:nn {tikzffbd/loop}{
  condition .tl_set:N=\l__ffbd_loop_label_tl,
  label .tl_set:N=\l__ffbd_loop_label_tl,
  side .choice:,
  side/above .code:n={\tl_set:Nn \l__ffbd_loop_side_tl {above}},
  side/below .code:n={\tl_set:Nn \l__ffbd_loop_side_tl {below}}}
\NewDocumentCommand \__ffbd_legacy_loop {O{}mm}{
  \__ffbd_require:n {#2}\__ffbd_require:n {#3}
  \tl_clear:N \l__ffbd_loop_label_tl
  \tl_set:Nn \l__ffbd_loop_side_tl {above}
  \keys_set:nn {tikzffbd/loop}{#1}
  \seq_put_right:Nx \l__ffbd_loops_seq
    {{#2}{#3}{\exp_not:V\l__ffbd_loop_label_tl}
      {\exp_not:V\l__ffbd_loop_side_tl}}
}

% External annotations
\cs_new_protected:Npn \__ffbd_annotate:nnn #1#2#3{
  \__ffbd_require:n {#2}
  \prop_get:NnNTF \l__ffbd_annotation_prop {#2}\l_tmpa_tl
    {\tl_put_right:Nn \l_tmpa_tl {\\[1pt]\textbf{#1:}~#3}}
    {\tl_set:Nn \l_tmpa_tl {\textbf{#1:}~#3}}
  \prop_put:NnV \l__ffbd_annotation_prop {#2}\l_tmpa_tl
}
\NewDocumentCommand \__ffbd_legacy_precondition {mm}
